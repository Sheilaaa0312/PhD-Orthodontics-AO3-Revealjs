library(tidyverse)
library(ggthemes)
titanic <- titanic::titanic_train |>
as_tibble() |>
janitor::clean_names()
titanic |>
drop_na(age) |>
mutate(sex = str_to_title(sex)) |>
mutate(age_group = case_when(
age < 18 ~ "Children (age < 18)",
age >= 55 ~ "Old Person (age >= 55)",
age >= 18 & age < 55 ~ "Adult"
)) |>
group_by(pclass, sex, age_group) |>
summarize(survival_rate = mean(survived)) |>
ggplot(aes(x = pclass, y = survival_rate, fill = sex)) +
geom_col(position = "dodge") +
labs(x = "Class", y = "Survival Rate", title = "Survival Rates of the Titanic - Xueying Luo", fill = "") +
facet_wrap(~age_group) +
theme_minimal() +
theme(legend.position = "bottom")
library(tidyverse)
library(ggthemes)
titanic <- titanic::titanic_train |>
as_tibble() |>
janitor::clean_names()
titanic |>
drop_na(age) |>
mutate(sex = str_to_title(sex)) |>
mutate(age_group = case_when(
age < 18 ~ "Children (age < 18)",
age >= 55 ~ "Old Person (age >= 55)",
age >= 18 & age < 55 ~ "Adult"
)) |>
group_by(pclass, sex, age_group) |>
summarize(survival_rate = mean(survived)) |>
ggplot(aes(x = pclass, y = survival_rate, fill = sex)) +
geom_col(position = "dodge") +
scale_fill_manual(values = c("Female" = "blue", "Male" = "red")) +
labs(
x = "Class",
y = "Survival Rate",
title = "Survival Rates of the Titanic - Xueying Luo",
fill = ""
) +
facet_wrap(~age_group) +
theme_minimal() +
theme(legend.position = "bottom")

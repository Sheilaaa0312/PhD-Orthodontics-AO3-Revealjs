titanic <- titanic::titanic_train |>
as_tibble() |>
janitor::clean_names()
titanic <- titanic::titanic_train |>
as_tibble() |>
janitor::clean_names()
titanic |>
drop_na(age) |>
group_by(sex) |>
summarize(survival_rate = mean(survived, na.rm = T)) |>
ggplot(aes(x = pclass, y = survival_rate)) +
labs(x = "Class", y = "Survival Rate", title = "Survival Rates of the Titanic - Xueying Luo") +
geom_col(position = "dodge") + # put bars side-by-side
theme(legend.position = "bottom")
